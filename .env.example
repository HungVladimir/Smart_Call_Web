# =================================================================
# SMARTCALL WEB — BIẾN MÔI TRƯỜNG DỰ ÁN MẪU (ENVIRONMENT TEMPLATE)
# Hướng dẫn: Sao chép tệp này thành .env và điền địa chỉ máy chủ thật
# Lệnh terminal: cp .env.example .env
# =================================================================

# 1. Địa chỉ Máy chủ Tổng đài Wazo Platform
# Định dạng: <IP_LAN>:<PORT_HTTPS> (Ví dụ: 192.168.1.100:9443)
VITE_WAZO_HOST=your-wazo-host:9443
VITE_WAZO_CLIENT_ID=webapp-vue

# 2. Địa chỉ API Cơ sở dữ liệu nội bộ
VITE_COMPANY_API_URL=https://your-wazo-host:9443/api

# 3. Chế độ hoạt động mặc định:
# - 'offline_mock': Sử dụng dữ liệu mô phỏng khi chưa kết nối máy chủ LAN
# - 'wazo_lan': Kết nối trực tiếp tới máy chủ Wazo tổng đài
VITE_APP_MODE=wazo_lan
