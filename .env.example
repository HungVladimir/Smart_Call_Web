# =================================================================
# SMARTCALL WEB — BIẾN MÔI TRƯỜNG DỰ ÁN (ENVIRONMENT CONFIGURATION)
# =================================================================

# 1. Địa chỉ Máy chủ Tổng đài Wazo Platform 26.10 trong mạng LAN nội bộ SDV
# Format: <IP_LAN>:<PORT_HTTPS>
VITE_WAZO_HOST=192.168.1.50:9443
VITE_WAZO_CLIENT_ID=sdv-webapp-vue

# 2. Địa chỉ API Cơ sở dữ liệu công ty (Do anh Hải phát triển & cung cấp)
VITE_COMPANY_API_URL=http://192.168.1.50:8080/api

# 3. Chế độ hoạt động mặc định:
# - 'offline_mock': Sử dụng dữ liệu giả lập chuẩn SDV khi dev ở nhà không có LAN
# - 'wazo_lan': Kết nối thật tới máy chủ Wazo tại nhà máy
VITE_APP_MODE=offline_mock

