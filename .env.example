# =================================================================
# SMARTCALL WEB — BIẾN MÔI TRƯỜNG DỰ ÁN (ENVIRONMENT CONFIGURATION)
# =================================================================

# 1. Địa chỉ Máy chủ Tổng đài Wazo Platform
# Format: <IP_LAN>:<PORT_HTTPS>
VITE_WAZO_HOST=107.126.11.126:9443
VITE_WAZO_CLIENT_ID=webapp-vue

# 2. Địa chỉ API Cơ sở dữ liệu nội bộ
VITE_COMPANY_API_URL=https://107.126.11.126:9443/api

# 3. Chế độ hoạt động mặc định:
# - 'offline_mock': Sử dụng dữ liệu mô phỏng khi chưa kết nối máy chủ LAN
# - 'wazo_lan': Kết nối trực tiếp tới máy chủ Wazo tổng đài
VITE_APP_MODE=wazo_lan
