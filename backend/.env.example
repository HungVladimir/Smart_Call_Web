# Copy thành backend/.env; không đưa .env hoặc token/secret lên Git.
SMARTCALL_PUBLIC_ORIGIN=http://localhost:8800
SMARTCALL_IDP_ISSUER=
SMARTCALL_IDP_CLIENT_ID=
SMARTCALL_IDP_CLIENT_SECRET=
# Giữ URL discovery/JWKS thực tế nếu IdP dùng đường dẫn riêng như dự án mẫu.
SMARTCALL_IDP_DISCOVERY_URL=
SMARTCALL_IDP_JWKS_URI=
SMARTCALL_IDP_SCOPE=openid
SMARTCALL_IDP_PKCE_ENABLED=true
SMARTCALL_IDP_REQUIRE_VERIFIED_EMAIL=false
SMARTCALL_ALLOWED_EMAIL_DOMAINS=samsung.com
SMARTCALL_REDIS_URL=redis://localhost:6379/0
SMARTCALL_SESSION_TTL=3600
# CA PEM nội bộ cho cả HTTP IdP/Wazo. Không tắt xác minh TLS.
SMARTCALL_TLS_CA_FILE=
SMARTCALL_WAZO_URL=https://107.126.11.126:9443
SMARTCALL_WAZO_ADMIN_USERNAME=
SMARTCALL_WAZO_ADMIN_PASSWORD=
SMARTCALL_WAZO_TENANT_UUID=
SMARTCALL_WAZO_PROVISIONING_ENABLED=true
# Mật khẩu TEST do người dùng yêu cầu; đổi bằng cấu hình khi kết thúc thử nghiệm.
SMARTCALL_WAZO_DEFAULT_PASSWORD=12345
SMARTCALL_WAZO_CONTEXT=internal
SMARTCALL_WAZO_TEMPLATE_LABELS=global,webrtc
SMARTCALL_WAZO_EXTENSION_MIN=1000
SMARTCALL_WAZO_EXTENSION_MAX=9999
# Bật nếu muốn thử mật khẩu trên tài khoản đã có; không reset mật khẩu cũ.
SMARTCALL_WAZO_EXISTING_PASSWORD_LOGIN=false
