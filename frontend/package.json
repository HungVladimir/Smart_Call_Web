    "format:check": "prettier --check src tests scripts *.js"
  },
  "dependencies": {
    "@wazo/sdk": "^0.49.11",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.6",
    "vite": "^8.2.2",
    "vitest": "^5.1.1",
    "@babel/parser": "7.29.13",
    "@vue/compiler-sfc": "3.5.45"
  },
  "engines": {
    "node": "^22.18.0 || ^24.12.0 || >=26.0.0"
  }
