{
  "name": "smart-call-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write src tests scripts *.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "check:architecture": "node scripts/check-architecture.mjs",
