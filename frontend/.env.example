# Cấu hình công khai cho ứng dụng Web. Sao chép sang .env nếu chưa có.
# Vite đưa VITE_* vào bundle trình duyệt; không đặt secret tại đây.
# Dùng host tổng đài thực tế, ví dụ pbx.example.internal:9443.
VITE_WAZO_HOST=your-wazo-host:9443

# Danh bạ phân trang bật mặc định. Đặt false và build lại để dùng giao diện danh bạ cũ.
# VITE_SMARTCALL_PAGED_DIRECTORY=false
# Chỉ cấu hình khi profile default có nhiều nguồn Wazo và cần chỉ rõ nguồn nhân viên.
# VITE_WAZO_DIRECTORY_SOURCE_UUID=

# Client ID được tạo riêng cho từng tab trong AuthService.
# Single ID dùng cấu hình riêng trong backend/.env.
