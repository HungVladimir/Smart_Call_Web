    {
      "name": "2. API SmartCall dùng User Token (Port 8801 / 8800)",
      "item": [
        {
          "name": "2.1 Danh sách bộ phận (/api/directory/departments)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Đọc danh sách bộ phận thành công', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().items).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Auth-Token", "value": "{{wazo_user_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
