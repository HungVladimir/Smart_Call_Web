          "request": {
            "method": "POST",
            "header": [
              { "key": "X-SmartCall-Test-Key", "value": "{{wrapper_test_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"PUT\",\n  \"path\": \"/api/confd/1.1/users/{{target_user_uuid}}\",\n  \"body\": {\n    \"description\": \"{{test_department}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{backend_base}}/api/wrapper",
              "host": ["{{backend_base}}"],
              "path": ["api", "wrapper"]
            },
            "description": "Nên dùng UUID của tài khoản thử để tránh ghi đè dữ liệu người thật."
          }
