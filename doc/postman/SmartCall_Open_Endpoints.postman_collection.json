{
  "info": {
    "_postman_id": "7f6b9a10-2611-4026-9801-smartcall0001",
    "name": "SmartCall - Open Ports & Wrapper Suite",
    "description": "Bộ test Postman cho các cổng và đầu API đang mở (không bị chặn) trên SmartCall Backend (port 8801 hoặc qua Vite proxy port 8800): /api/health, /api/wrapper/contexts, /api/register, toàn bộ 5 nhóm Wazo trong POST /api/wrapper (confd, dird, chatd, calld, call-logd) và các API User Token (/api/directory/*, /api/call-groups).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Kiểm tra cổng đang mở (Health)",
      "item": [
        {
          "name": "0.1 Health Backend trực tiếp (Port 8801)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Backend 8801 phản hồi 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{backend_base}}/api/health",
              "host": ["{{backend_base}}"],
              "path": ["api", "health"]
            },
            "description": "Kiểm tra trực tiếp tiến trình FastAPI ở {{backend_base}} (mặc định http://127.0.0.1:8801). Không cần key hay token."
          }
        },
        {
          "name": "0.2 Health qua Vite Proxy (Port 8800)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vite proxy 8800 chuyển tiếp /api/health thành công', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{public_origin}}/api/health",
              "host": ["{{public_origin}}"],
              "path": ["api", "health"]
            },
            "description": "Kiểm tra cổng Frontend Vite (http://localhost:8800) chuyển tiếp /api sang backend 8801. Chỉ chạy được khi đã bật npm run dev."
          }
        }
      ]
    },
    {
      "name": "1. Wrapper Admin & Register (Port 8801 / 8800, chỉ cần X-SmartCall-Test-Key)",
      "item": [
        {
          "name": "1.1 Pilot - GET /api/wrapper/contexts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Đọc danh sách context thành công', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.items).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-SmartCall-Test-Key", "value": "{{wrapper_test_key}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{backend_base}}/api/wrapper/contexts?limit=30&offset=0",
              "host": ["{{backend_base}}"],
              "path": ["api", "wrapper", "contexts"],
              "query": [
                { "key": "limit", "value": "30" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "Endpoint đọc context bản thử đầu tiên. Yêu cầu X-SmartCall-Test-Key."
          }
        },
        {
          "name": "1.2 Confd - Đọc danh sách user (lấy target_user_uuid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Wrapper Confd GET /users thành công và đã lọc secret', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.items).to.be.an('array');",
                  "  if (data.items.length > 0) {",
                  "    pm.expect(data.items[0]).to.not.have.property('auth');",
                  "    pm.expect(data.items[0]).to.not.have.property('userfield');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-SmartCall-Test-Key", "value": "{{wrapper_test_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"GET\",\n  \"path\": \"/api/confd/1.1/users\",\n  \"query\": {\n    \"limit\": 10,\n    \"offset\": 0,\n    \"recurse\": false\n  }\n}"
            },
            "url": {
              "raw": "{{backend_base}}/api/wrapper",
              "host": ["{{backend_base}}"],
              "path": ["api", "wrapper"]
            },
            "description": "Chạy bước này đầu tiên để lấy uuid của một user bất kỳ trong items[].uuid gán vào biến môi trường {{target_user_uuid}}."
          }
        },
        {
          "name": "1.3 Confd - Đọc hồ sơ + description của user khác theo UUID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Đọc hồ sơ user qua Wrapper thành công và không lộ trường nhạy cảm', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data).to.have.property('uuid');",
                  "  pm.expect(data).to.not.have.property('auth');",
                  "  pm.expect(data).to.not.have.property('password');",
                  "  pm.expect(data).to.not.have.property('userfield');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-SmartCall-Test-Key", "value": "{{wrapper_test_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"GET\",\n  \"path\": \"/api/confd/1.1/users/{{target_user_uuid}}\",\n  \"query\": {\n    \"view\": \"directory\"\n  }\n}"
            },
            "url": {
              "raw": "{{backend_base}}/api/wrapper",
              "host": ["{{backend_base}}"],
              "path": ["api", "wrapper"]
            },
            "description": "Ca kiểm chứng chính: user thường gọi trực tiếp Wazo bị từ chối quyền, gọi qua /api/wrapper lấy được description và thông tin công khai của user khác."
          }
        },
        {
          "name": "1.4 Confd - Cập nhật description cho user (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cập nhật description thành công (204 -> 200 ok)', function () {",
                  "  pm.response.to.have.status(200);",
